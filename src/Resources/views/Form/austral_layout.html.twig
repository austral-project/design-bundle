{#
 # Theme of the Austral forms for the administration: renders the view contract of form-bundle
 # (form.vars.austral_layout, form.vars.austral and form.vars.austral_entry) with the Twig components of the
 # design system. Reference: @AustralForm/form/austral_layout.html.twig (minimal theme of form-bundle).
 #
 #   twig:
 #     form_themes: ['@AustralDesign/Form/austral_layout.html.twig']
 #}
{% use 'form_div_layout.html.twig' with form_row as base_form_row %}

{# Root form and every entry of a collection (block prefix austral_form) #}
{%- block austral_form_widget -%}
  {%- import _self as austral -%}
  {%- set attr = attr|filter((value, name) => name != 'novalidate') -%}
  <div {% with {attr: attr|merge({class: ('fields-container ' ~ (attr.class ?? ''))|trim})} %}{{ block('widget_container_attributes') }}{% endwith %}>
    {%- if form is rootform -%}
      {{- form_errors(form) -}}
    {%- endif -%}
    {%- for node in austral_layout -%}
      {{- austral.node(node, form) -}}
    {%- endfor -%}
    {{- form_rest(form) -}}
  </div>
{%- endblock austral_form_widget -%}

{# A field of an Austral form: its presentation (form.vars.austral) in the Austral:Form:Row component #}
{%- block form_row -%}
  {%- if austral is defined and austral is not null -%}
    {%- import _self as macros -%}
    {%- set type_field = macros.type_field(austral, block_prefixes)|trim -%}
    {%- set label_position = austral.label_position ?: 'external' -%}
    {%- set widget_vars = austral.helper ? {attr: attr|merge({'aria-describedby': id ~ '_helper'})} : {} -%}
    {%- if not valid -%}
      {%- set widget_vars = {attr: (widget_vars.attr ?? attr)|merge({'aria-describedby': id ~ '_errors'})} -%}
    {%- endif -%}
    {%- set before_html = macros.slot(austral.before, form)|trim -%}
    {%- set after_html = macros.slot(austral.after, form)|trim -%}
    <twig:Austral:Form:Row tag="{{ tag|default('li') }}"
      fieldClassContainer="{{ [austral.container_class, austral.size]|filter(value => value)|join(' ') }}"
      attr="{{ row_attr }}"
      typeField="{{ type_field }}"
      name="{{ name }}"
      animateLabel="{{ type_field != 'toggle' }}"
      labelPosition="{{ label_position }}"
      disabled="{{ disabled }}"
      required="{{ required }}"
    >
      <twig:block name="label">
        {%- if label_position != 'external' and type_field != 'checkbox' -%}
          {{- form_label(form) -}}
        {%- endif -%}
      </twig:block>
      <twig:block name="label_external">
        {%- if label_position == 'external' or type_field == 'checkbox' -%}
          {{- form_label(form) -}}
        {%- endif -%}
      </twig:block>
      <twig:block name="field">
        {{- form_widget(form, widget_vars) -}}
      </twig:block>
      <twig:block name="error">
        {{- form_errors(form) -}}
      </twig:block>
      <twig:block name="before">
        {{- before_html|raw -}}
      </twig:block>
      <twig:block name="after">
        {%- if after_html -%}
          {{- after_html|raw -}}
        {%- elseif austral.field_class == 'uploadField' -%}
          {{- macros.upload_infos(austral.widget, translation_domain) -}}
        {%- elseif austral.field_class == 'passwordField' -%}
          <twig:Austral:Button htmlTag="button" type="button" class="password-toggle" hideEntitled="{{ true }}" theme="ghost" data-password-toggle="#{{ id }}">
            <twig:block name="picto">
              <twig:Austral:Picto class="show" name="eye"></twig:Austral:Picto>
              <twig:Austral:Picto class="hide" name="eyenot"></twig:Austral:Picto>
            </twig:block>
          </twig:Austral:Button>
        {%- endif -%}
      </twig:block>
      <twig:block name="helper">
        {%- if austral.helper -%}
          <ul id="{{ id }}_helper" class="helper-content">
            <li class="value">{{ austral.helper|trans({}, translation_domain) }}</li>
          </ul>
        {%- else -%}
          {{- form_help(form) -}}
        {%- endif -%}
      </twig:block>
    </twig:Austral:Form:Row>
  {%- else -%}
    {{- block('base_form_row') -}}
  {%- endif -%}
{%- endblock form_row -%}

{%- block textarea_widget -%}
  <twig:Austral:Form:Fields:Textarea field="{{ austral ?? null }}" id="{{ id }}" required="{{ required }}" disabled="{{ disabled }}" name="{{ full_name }}" datas="{{ attr }}" value="{{ value }}"/>
{%- endblock textarea_widget -%}

{%- block form_widget_simple -%}
  {%- set type = type|default('text') -%}
  {%- if type == 'file' -%}
    <twig:Austral:Form:Fields:Upload field="{{ austral ?? null }}" fieldname="{{ name }}" type="{{ type }}" id="{{ id }}" name="{{ full_name }}" required="{{ required }}" disabled="{{ disabled }}" datas="{{ attr }}" value="{{ value }}"/>
  {%- elseif type == 'hidden' -%}
    <div class="field-row field-row-hidden field-row-{{ name }}">
      <twig:Austral:Form:Fields:Input field="{{ austral ?? null }}" type="{{ type }}" id="{{ id }}" name="{{ full_name }}" required="{{ required }}" disabled="{{ disabled }}" datas="{{ attr }}" value="{{ value }}"/>
    </div>
  {%- else -%}
    <twig:Austral:Form:Fields:Input field="{{ austral ?? null }}" type="{{ type }}" id="{{ id }}" name="{{ full_name }}" required="{{ required }}" disabled="{{ disabled }}" datas="{{ attr }}" value="{{ value }}"/>
  {%- endif -%}
{%- endblock form_widget_simple -%}

{%- block checkbox_widget -%}
  {%- if (austral.field_class ?? null) == 'switchField' -%}
    <twig:Austral:Form:Fields:Toggle type="checkbox" id="{{ id }}" name="{{ full_name }}" required="{{ required }}" field="{{ austral }}" disabled="{{ disabled }}" datas="{{ attr }}" value="{{ value is defined ? value : null }}" checked="{{ checked }}"/>
  {%- else -%}
    <twig:Austral:Form:Fields:Input type="checkbox" id="{{ id }}" name="{{ full_name }}" required="{{ required }}" field="{{ austral ?? null }}" disabled="{{ disabled }}" datas="{{ attr }}" value="{{ value is defined ? value : null }}" checked="{{ checked }}">
      <twig:block name="picto">
        <twig:Austral:Picto name="check"></twig:Austral:Picto>
      </twig:block>
    </twig:Austral:Form:Fields:Input>
  {%- endif -%}
{%- endblock checkbox_widget -%}

{%- block radio_widget -%}
  <twig:Austral:Form:Fields:Input type="radio" id="{{ id }}" name="{{ full_name }}" required="{{ required }}" field="{{ austral ?? null }}" disabled="{{ disabled }}" datas="{{ attr }}" value="{{ value is defined ? value : null }}" checked="{{ checked }}">
    <twig:block name="picto">
      <twig:Austral:Picto name="check"></twig:Austral:Picto>
    </twig:block>
  </twig:Austral:Form:Fields:Input>
{%- endblock radio_widget -%}

{%- block choice_widget_expanded -%}
  {%- set widget = austral.widget ?? {} -%}
  {%- set input_type = multiple ? 'checkbox' : 'radio' -%}
  {%- if (widget.theme ?? null) == 'choiceElement' -%}
    <div class="field field-choice-element field-items">
      <twig:Austral:Form:Fields:Switcher id="{{ id }}" size="full" theme="solid" direction="{{ widget.direction ?? 'horizontal' }}" multiple="{{ multiple }}" attr="{{ attr }}">
        <twig:block name="choices_html">
          {%- for child in form -%}
            <li class="switcher-item field-item {{ child.vars.disabled ? 'disabled' }}" data-focusable>
              <div class="switcher-item-content">
                <twig:Austral:Form:Fields:Input type="{{ input_type }}" id="{{ child.vars.id }}" name="{{ child.vars.full_name }}" disabled="{{ child.vars.disabled }}" value="{{ child.vars.value }}" checked="{{ child.vars.checked }}" datas="{{ child.vars.attr }}"/>
                <twig:Austral:Form:Label tag="label" entitled="{{ child.vars.label|trans({}, choice_translation_domain) }}" id="{{ child.vars.id }}"/>
              </div>
            </li>
          {%- endfor -%}
        </twig:block>
      </twig:Austral:Form:Fields:Switcher>
    </div>
  {%- elseif (austral.field_class ?? null) == 'choiceField' and (widget.direction ?? null) == 'vertical' -%}
    <twig:Austral:Form:Fields:Switcher id="{{ id }}" theme="solid">
      <twig:block name="choices">
        {%- for child in form -%}
          <li class="switcher-item field-item">
            <div class="switcher-item-content">
              <twig:Austral:Form:Fields:Input type="{{ input_type }}" id="{{ child.vars.id }}" name="{{ child.vars.full_name }}" required="{{ child.vars.required }}" disabled="{{ child.vars.disabled }}" datas="{{ child.vars.attr }}" value="{{ child.vars.value }}" checked="{{ child.vars.checked }}"/>
              {{- form_label(child, null, {translation_domain: choice_translation_domain}) -}}
            </div>
          </li>
        {%- endfor -%}
      </twig:block>
    </twig:Austral:Form:Fields:Switcher>
  {%- elseif (austral.field_class ?? null) == 'choiceField' or (widget.theme ?? null) == 'choiceList' -%}
    <twig:Austral:Form:Fields:ChoiceList id="{{ id }}" type="{{ input_type }}">
      <twig:block name="choices">
        {%- for child in form -%}
          <li class="choice-item field-item {{ child.vars.disabled or (child.vars.attr.disabled ?? false) ? 'disabled' }}" data-focusable>
            <div class="choice-item-content">
              <twig:Austral:Form:Fields:Input type="{{ input_type }}" id="{{ child.vars.id }}" name="{{ child.vars.full_name }}" required="{{ child.vars.required }}" disabled="{{ child.vars.disabled or (child.vars.attr.disabled ?? false) }}" datas="{{ child.vars.attr }}" value="{{ child.vars.value }}" checked="{{ child.vars.checked }}">
                <twig:block name="picto">
                  <twig:Austral:Picto name="check"></twig:Austral:Picto>
                </twig:block>
              </twig:Austral:Form:Fields:Input>
              {{- form_label(child, null, {translation_domain: choice_translation_domain}) -}}
            </div>
          </li>
        {%- endfor -%}
      </twig:block>
    </twig:Austral:Form:Fields:ChoiceList>
  {%- else -%}
    <ul {% with {attr: {class: 'field-list-content field-choice-list field-items list-' ~ name ~ '-content'}} %}{{ block('widget_container_attributes') }}{% endwith %}>
      {%- for child in form -%}
        <li class="field-list-element choice-item field-item">
          {{- form_widget(child) -}}
          {{- form_label(child, null, {translation_domain: choice_translation_domain}) -}}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- endblock choice_widget_expanded -%}

{# CollectionEmbedField: the entries, the prototype given to the JS component (data-collection) and the buttons #}
{%- block collection_widget -%}
  {%- if (austral.field_class ?? null) == 'collectionEmbedField' -%}
    {%- import _self as macros -%}
    {%- set widget = austral.widget -%}
    {%- set templates = {} -%}
    {%- if (widget.allow.add ?? false) and prototype is defined and not (widget.master_children ?? false) -%}
      {%- set templates = {(name): macros.collection_entry(prototype, widget, 'init-form')} -%}
    {%- endif -%}
    <div id="{{ id }}-content-embed" class="collection-embed-fields collection-embed-fields-master" data-collection="{{ {keyname: name, templates: templates}|json_encode }}">
      {{- macros.collection_add(name, widget, translation_domain, 'top', templates is not empty) -}}
      <div class="collection-embed-forms form-{{ name }}" data-collection-container="{{ name }}" data-replace-id="{{ widget.prototype_name }}"{% if widget.sortable %} data-sortable="" data-sortable-draggable=".collection-embed-element" data-sortable-handle=".sortable-handle" data-sortable-input="*[data-collection-sortabled]"{% endif %}>
        {%- for entry in form -%}
          {{- macros.collection_entry(entry, widget, '') -}}
        {%- endfor -%}
      </div>
      {{- macros.collection_add(name, widget, translation_domain, 'bottom toggle-view' ~ (form|length > 0 ? '' : ' hide'), templates is not empty) -}}
    </div>
  {%- else -%}
    {{- block('form_widget') -}}
  {%- endif -%}
{%- endblock collection_widget -%}

{%- block form_errors -%}
  {%- if errors|length > 1 -%}
    <ul id="{{ form.vars.id }}_errors">
      {%- for error in errors -%}
        <li>{{ error.message }}</li>
      {%- endfor -%}
    </ul>
  {%- elseif errors|length > 0 -%}
    <p id="{{ form.vars.id }}_errors">{% for error in errors %}{{ error.message }}{% endfor %}</p>
  {%- endif -%}
{%- endblock form_errors -%}

{# ---- Macros ---- #}

{# Type of the row (CSS class field-row-<type>), from the Austral field class or the Symfony block prefixes #}
{% macro type_field(austral, block_prefixes) -%}
  {%- set widget = austral.widget ?? {} -%}
  {%- if austral.field_class == 'choiceField' -%}
    {{- (widget.direction ?? null) == 'vertical' ? 'switcher' : 'choice-list' -}}
  {%- elseif (widget.theme ?? null) == 'choiceElement' -%}
    choice-element
  {%- elseif austral.field_class == 'switchField' -%}
    toggle
  {%- elseif austral.field_class == 'wysiwygField' -%}
    wysiwyg
  {%- elseif austral.field_class == 'colorField' -%}
    color-picker
  {%- else -%}
    {{- block_prefixes|length > 3 ? block_prefixes[2] : (block_prefixes[1] ?? '') -}}
  {%- endif -%}
{%- endmacro %}

{% macro node(node, form) -%}
  {%- import _self as austral -%}
  {%- set translation_domain = form.vars.translation_domain -%}
  {%- set attributes = node.attr ?? {} -%}
  {%- if node.type == 'fieldset' -%}
    {%- set collapse = node.collapse and node.show_label and node.label -%}
    <fieldset id="{{ node.id }}" class="fieldset fieldset-{{ node.name }} fieldset-position-{{ node.position }}{{ attributes.class is defined ? ' ' ~ attributes.class }}"{% if collapse %} data-collapse{% endif %}{{ austral.attributes(attributes|filter((value, name) => name != 'class')) }}>
      <div class="fieldset-content">
        {%- if node.show_label and node.label is not same as(false) and node.label is not null -%}
          <twig:Austral:Title htmlTag="h3" value="{{ node.label|trans(node.label_parameters, translation_domain) }}">
            <twig:block name="after">
              {%- if collapse -%}
                <span class="pictos"><span class="open"><twig:Austral:Picto name="arrow-down"/></span><span class="close"><twig:Austral:Picto name="arrow-up"/></span></span>
              {%- endif -%}
            </twig:block>
          </twig:Austral:Title>
        {%- endif -%}
        <ul class="fields-rows-container">
          {{- austral.children(node.children, form) -}}
        </ul>
      </div>
    </fieldset>
  {%- elseif node.type == 'group' -%}
    <li id="{{ node.id }}" class="groups-fields {{ [node.name, node.direction, node.size, node.style]|filter(value => value)|join(' ') }}"{{ austral.attributes(attributes) }}>
      {%- if node.label is not same as(false) and node.label is not null -%}
        <twig:Austral:Title htmlTag="h4" theme="title-4" value="{{ node.label|trans({}, translation_domain) }}" class="field-group-entitled"/>
      {%- endif -%}
      <ul class="fields-rows-container">
        {{- austral.children(node.children, form) -}}
      </ul>
    </li>
  {%- elseif node.type == 'modal' -%}
    {%- set button_label = node.button.label ?? node.label -%}
    <li class="field-modal">
      <twig:Austral:Button htmlTag="button" type="button" class="{{ node.button.class }}" entitled="{{ button_label is not same as(false) and button_label is not null ? button_label|trans({}, translation_domain) : '' }}" data-modal-open="{{ node.id }}">
        {%- if node.button.picto -%}
          <twig:block name="picto"><twig:Austral:Picto name="{{ node.button.picto }}"/></twig:block>
        {%- endif -%}
      </twig:Austral:Button>
      <twig:Austral:Modal modalId="{{ node.id }}" classValue="{{ node.modal.class ?? '' }}">
        <twig:block name="content">
          {%- if node.label is not same as(false) and node.label is not null -%}
            <twig:Austral:Title htmlTag="h2" value="{{ node.label|trans({}, translation_domain) }}"/>
          {%- endif -%}
          <ul class="fields-rows-container">
            {{- austral.children(node.children, form) -}}
          </ul>
        </twig:block>
      </twig:Austral:Modal>
    </li>
  {%- elseif node.type == 'template' -%}
    {%- if node.template -%}
      {{- include(node.template, node.template_vars|merge({form: form, austral: node.austral})) -}}
    {%- endif -%}
  {%- elseif node.type == 'variants' -%}
    <li id="{{ node.id }}" class="collection-variants">
      {%- for name in node.children -%}
        {{- form_row(form[name], {tag: 'div'}) -}}
      {%- endfor -%}
    </li>
  {%- endif -%}
{%- endmacro %}

{% macro children(children, form) -%}
  {%- import _self as austral -%}
  {%- for child in children -%}
    {%- if child is iterable -%}
      {{- austral.node(child, form) -}}
    {%- else -%}
      {{- form_row(form[child], {tag: 'li'}) -}}
    {%- endif -%}
  {%- endfor -%}
{%- endmacro %}

{# A slot (before / after the widget): HTML, a template or a Twig component #}
{% macro slot(slot, form) -%}
  {%- if slot is not null -%}
    {%- if slot.html -%}
      {{- slot.html|raw -}}
    {%- elseif slot.template -%}
      {{- include(slot.template, slot.parameters|merge({form: form})) -}}
    {%- elseif slot.component -%}
      {{- component(slot.component, slot.parameters) -}}
    {%- endif -%}
  {%- endif -%}
{%- endmacro %}

{# Accepted files of an UploadField (form.vars.austral.widget) #}
{% macro upload_infos(widget, translation_domain) -%}
  <div class="file-upload-info">
    {%- if widget.extensions -%}
      <p>{{ 'form.upload.extensions'|trans({'%extensions%': widget.extensions|join(' ')}, 'austral') }}</p>
    {%- endif -%}
    {%- for key, value in widget.image_sizes|filter(value => value) -%}
      <p>{{ ('form.upload.' ~ key)|trans({'%size%': value}, 'austral') }}</p>
    {%- endfor -%}
    {%- if widget.max_size -%}
      <p>{{ 'form.upload.max_size'|trans({'%size%': (widget.max_size / 1048576)|round(1)}, 'austral') }}</p>
    {%- endif -%}
  </div>
{%- endmacro %}

{# An entry of a CollectionEmbedField (form.vars.austral_entry: sortable value) #}
{% macro collection_entry(entry, widget, class) -%}
  <div data-embed-id="{{ entry.vars.name }}" class="collection-embed-element attachement no-between-insert {{ class }}{{ entry.vars.errors|length > 0 ? ' error' }}">
    <div class="hover">
      <div class="collection-embed-form">
        {%- if widget.sortable -%}
          <span class="sortable-content"><span class="sortable-handle"><twig:Austral:Picto name="move"/></span></span>
        {%- endif -%}
        {%- if widget.allow.delete ?? false -%}
          <span class="delete-content" data-delete=".collection-embed-element"><twig:Austral:Picto name="trash"/></span>
        {%- endif -%}
        {%- if entry.vars.errors|length > 0 -%}
          <div class="error-content master">{{ form_errors(entry) }}</div>
        {%- endif -%}
        {{- form_widget(entry) -}}
      </div>
    </div>
  </div>
{%- endmacro %}

{# Button that adds an entry to a CollectionEmbedField #}
{% macro collection_add(name, widget, translation_domain, class, enabled) -%}
  {%- if enabled -%}
    <div class="collections-add-content add-new-collection-embed {{ class }}">
      <twig:Austral:Button htmlTag="span" size="sm" type="button" entitled="{{ widget.button ? widget.button|trans({}, translation_domain) : '' }}" data-collection-add="{{ name }}">
        <twig:block name="picto">
          <twig:Austral:Picto name="plus"/>
        </twig:block>
      </twig:Austral:Button>
    </div>
  {%- endif -%}
{%- endmacro %}

{% macro attributes(attributes) -%}
  {%- for name, value in attributes -%}
    {{- ' ' -}}{{ name }}="{{ value }}"
  {%- endfor -%}
{%- endmacro %}
