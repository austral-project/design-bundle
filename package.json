{
  "name": "@austral/design",
  "version": "4.0.0",
  "description": "Design system of Austral: Twig components, styles and JavaScript of the front and of the administration.",
  "license": "MIT",
  "author": {
    "name": "Matthieu Beurel",
    "email": "matthieu@austral.dev",
    "url": "https://austral.dev"
  },
  "homepage": "https://austral.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austral-project/design-bundle.git"
  },
  "bugs": {
    "url": "https://github.com/austral-project/design-bundle/issues"
  },
  "private": false,
  "main": "./src/Resources/assets/index.js",
  "exports": {
    ".": "./src/Resources/assets/index.js",
    "./components/*": "./src/Resources/assets/components/*",
    "./core/*": "./src/Resources/assets/core/*",
    "./debug/*": "./src/Resources/assets/debug/*",
    "./dom/*": "./src/Resources/assets/dom/*",
    "./libraries/*": "./src/Resources/assets/libraries/*",
    "./modules/*": "./src/Resources/assets/modules/*",
    "./utils/*": "./src/Resources/assets/utils/*",
    "./styles/*": "./src/Resources/assets/styles/*",
    "./svg/*": "./src/Resources/assets/svg/*",
    "./entries/*": "./src/Resources/assets/entries/*",
    "./encore": "./encore.mjs"
  },
  "files": [
    "encore.mjs",
    "scripts",
    "src/Resources/assets",
    "src/Resources/public/austral-picto",
    "src/Resources/public/images",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "encore dev",
    "watch": "encore dev --watch",
    "build": "encore production",
    "icons": "node scripts/editor-icons.js",
    "build:check": "npm run icons && npm run build && git add --intent-to-add -- src/Resources/public/build src/Resources/assets/components/form/fields/textarea/wysiwyg/icons.js && git diff --exit-code -- src/Resources/public/build src/Resources/assets/components/form/fields/textarea/wysiwyg/icons.js"
  },
  "dependencies": {
    "@simonwep/pickr": "1.8.2",
    "autosize": "^4.0.2",
    "choices.js": "~10.1.0",
    "clipboard": "^2.0.11",
    "codemirror": "^5.65.0",
    "cropperjs": "^1.6.0",
    "event-source-polyfill": "^1.0.25",
    "gsap": "^3.14.2",
    "intl-tel-input": "^25.3.2",
    "js-beautify": "^1.15.0",
    "sortablejs": "^1.15.7",
    "suneditor": "^2.47.0",
    "sweetalert2": "^11.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@symfony/webpack-encore": "^7.2.0",
    "sass": "^1.80.0",
    "sass-loader": "^17.0.0",
    "webpack": "^5.82.0",
    "webpack-cli": "^7.0.0"
  },
  "browserslist": [
    "defaults",
    "not dead"
  ]
}
